{"name":"@userr/widget","version":"0.1.0","description":"Zero-dependency browser feedback launcher for Userr.","license":"MIT","type":"module","exports":{".":{"types":"./dist/index.d.ts","default":"./dist/index.js"}},"files":["dist"],"scripts":{"build":"tsc -p tsconfig.json && esbuild src/browser.ts --bundle --format=iife --global-name=Feedback --outfile=dist/widget.v1.js","test":"npm run build && npm run test:unit && npm run test:e2e","test:unit":"node --test dist/**/*.test.js","test:e2e":"playwright test --config playwright.config.ts","typecheck":"tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.e2e.json"},"devDependencies":{"@playwright/test":"^1.63.0","@types/jsdom":"^27.0.0","esbuild":"^0.25.12","jsdom":"^30.0.1","typescript":"^5.8.3"}}
